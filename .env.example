# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/patent_diff

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Processing
CHUNK_SIZE=512
CHUNK_OVERLAP=100
MAX_FILE_SIZE_MB=50

# Retrieval
TOP_K_RETRIEVAL=5
LEXICAL_BOOST_WEIGHT=0.3

# LLM
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Async
USE_JOB_QUEUE=false

# Logging
LOG_LEVEL=INFO
ENABLE_REQUEST_TIMING=true
